{
  "name": "Best Sellers E-commerce - Workflow Automatisé",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message.voice }}",
              "operation": "exists"
            }
          ]
        }
      },
      "id": "check-voice",
      "name": "Message Vocal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fileId": "={{ $json.message.voice.file_id }}",
        "operation": "get"
      },
      "id": "download-audio",
      "name": "Télécharger Audio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [650, 400],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "transcribeAudio",
        "binaryData": true,
        "options": {
          "language": "fr",
          "responseFormat": "text"
        }
      },
      "id": "transcribe",
      "name": "Transcrire avec Whisper",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [850, 400],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "merge",
      "name": "Merge Textes",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "text",
              "name": "text",
              "value": "={{ $json.message.text || $json.text }}",
              "type": "string"
            },
            {
              "id": "chat_id",
              "name": "chat_id",
              "value": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-text",
      "name": "Préparer Texte",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "options": {
          "temperature": 0.7,
          "maxTokens": 500
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un assistant intelligent qui analyse les demandes de recherche de produits e-commerce. Analyse la demande et retourne un JSON avec: {\"type\": \"recherche_produits\" ou \"autre\", \"plateforme\": \"amazon/aliexpress/temu/jumia\", \"categorie\": \"catégorie\", \"nombre\": nombre de produits, \"mots_cles\": [\"mot1\", \"mot2\"]}"
            },
            {
              "role": "user",
              "content": "={{ $json.text }}"
            }
          ]
        }
      },
      "id": "analyze-request",
      "name": "Analyser Demande (GPT-4)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [1250, 300],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json.choices[0].message.content;\ntry {\n  const parsed = JSON.parse(response);\n  return { json: parsed };\n} catch (e) {\n  return { json: { type: 'autre', error: response } };\n}"
      },
      "id": "parse-json",
      "name": "Parser JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "value2": "recherche_produits"
            }
          ]
        }
      },
      "id": "check-type",
      "name": "Type Recherche?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v0/scrape",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ 'https://www.' + $json.plateforme + '.com' }}"
            },
            {
              "name": "formats",
              "value": "markdown"
            },
            {
              "name": "pageOptions",
              "value": "{\"onlyMainContent\": true}"
            }
          ]
        },
        "options": {}
      },
      "id": "scrape-firecrawl",
      "name": "Scraping Firecrawl",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1850, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Firecrawl API"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": {
          "__rl": true,
          "value": "VOTRE_SHEET_ID",
          "mode": "id"
        },
        "options": {
          "useAppend": true
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "plateforme": "={{ $('Parser JSON').item.json.plateforme }}",
            "produit": "={{ $json.data.markdown }}",
            "date": "={{ $now }}"
          }
        }
      },
      "id": "save-google-sheets",
      "name": "Sauvegarder Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [2050, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "1",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-4",
        "options": {
          "temperature": 0.7
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un assistant qui génère des réponses personnalisées sur les produits e-commerce. Formate la réponse de manière claire avec les noms, prix, liens et descriptions des produits."
            },
            {
              "role": "user",
              "content": "Demande: {{ $('Préparer Texte').item.json.text }}\n\nDonnées scrapées: {{ JSON.stringify($('Scraping Firecrawl').item.json) }}\n\nGénère une réponse formatée pour l'utilisateur."
            }
          ]
        }
      },
      "id": "generate-response",
      "name": "Générer Réponse (GPT-4)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [2250, 200],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Préparer Texte').item.json.chat_id }}",
        "text": "={{ $json.choices[0].message.content }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-telegram",
      "name": "Envoyer Réponse Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [2450, 200],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Préparer Texte').item.json.chat_id }}",
        "text": "Je ne comprends pas votre demande. Veuillez demander une recherche de produits (ex: 'Recherche les best-sellers Amazon en électronique')."
      },
      "id": "send-error",
      "name": "Envoyer Message Erreur",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1850, 400],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{"node": "Message Vocal?", "type": "main", "index": 0}]]
    },
    "Message Vocal?": {
      "main": [
        [{"node": "Télécharger Audio", "type": "main", "index": 0}],
        [{"node": "Merge Textes", "type": "main", "index": 0}]
      ]
    },
    "Télécharger Audio": {
      "main": [[{"node": "Transcrire avec Whisper", "type": "main", "index": 0}]]
    },
    "Transcrire avec Whisper": {
      "main": [[{"node": "Merge Textes", "type": "main", "index": 1}]]
    },
    "Merge Textes": {
      "main": [[{"node": "Préparer Texte", "type": "main", "index": 0}]]
    },
    "Préparer Texte": {
      "main": [[{"node": "Analyser Demande (GPT-4)", "type": "main", "index": 0}]]
    },
    "Analyser Demande (GPT-4)": {
      "main": [[{"node": "Parser JSON", "type": "main", "index": 0}]]
    },
    "Parser JSON": {
      "main": [[{"node": "Type Recherche?", "type": "main", "index": 0}]]
    },
    "Type Recherche?": {
      "main": [
        [{"node": "Scraping Firecrawl", "type": "main", "index": 0}],
        [{"node": "Envoyer Message Erreur", "type": "main", "index": 0}]
      ]
    },
    "Scraping Firecrawl": {
      "main": [[{"node": "Sauvegarder Google Sheets", "type": "main", "index": 0}]]
    },
    "Sauvegarder Google Sheets": {
      "main": [[{"node": "Générer Réponse (GPT-4)", "type": "main", "index": 0}]]
    },
    "Générer Réponse (GPT-4)": {
      "main": [[{"node": "Envoyer Réponse Telegram", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2024-01-01T00:00:00.000Z",
  "versionId": "1"
}

