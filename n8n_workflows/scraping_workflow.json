{
  "name": "Scraping Quotidien - Système Multi-Agents",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Déclencheur Quotidien",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "python",
        "arguments": "daily_task.py",
        "options": {
          "cwd": "C:\\Users\\Lenovo\\Desktop\\projet_sys_rep"
        }
      },
      "id": "execute-scraping",
      "name": "Exécuter Scraping",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "readFile",
        "fileName": "={{ $json.output }}",
        "options": {}
      },
      "id": "read-report",
      "name": "Lire Rapport",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.success }}",
              "operation": "equal",
              "value2": "true"
            }
          ]
        }
      },
      "id": "check-success",
      "name": "Vérifier Succès",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "subject": "Rapport de Scraping Quotidien",
        "message": "Le scraping quotidien a été exécuté avec succès.",
        "toEmail": "votre-email@example.com"
      },
      "id": "send-email",
      "name": "Envoyer Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Déclencheur Quotidien": {
      "main": [
        [
          {
            "node": "Exécuter Scraping",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Exécuter Scraping": {
      "main": [
        [
          {
            "node": "Lire Rapport",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lire Rapport": {
      "main": [
        [
          {
            "node": "Vérifier Succès",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vérifier Succès": {
      "main": [
        [
          {
            "node": "Envoyer Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
